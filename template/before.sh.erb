<%- ppn = context.cores.to_i -%>

# Find available port
export port=$(find_port ${host})
export WWW_PORT=${port}

# Per-user Galaxy installation path (persistent across sessions)
export GALAXY_PATH="${HOME}/ondemand/data/Galaxy/galaxy"
export GALAXY_CONFIG_FILE="${PWD}/galaxy.yml"
DATAROOT=${HOME}/.galaxy
EMAIL="${USER}@nesi.org.nz"
export JOB_CONFIG_FILE_PATH="${PWD}/job_conf.yml"
export JOB_RESOURCE_PARAMS_CONF_FILE_PATH="${PWD}/job_resource_params_conf.xml"
export WORKFLOW_RESOURCE_PARAMS_CONF_FILE_PATH="${PWD}/workflow_resource_params_conf.xml"

echo "GALAXY location: '${GALAXY_PATH}'"
echo "Data location:   '${DATAROOT}'"
echo "Port:            '${port}'"

# NeSI Lmod environment
export LMOD_CONFIG_DIR=/opt/nesi/etc/lmod
export MODULEPATH_ROOT=/opt/nesi/lmod
export MODULEPATH=/opt/nesi/lmod/generic
export BASH_ENV=/usr/share/lmod/lmod/init/bash

# Export module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

ml NeSI/zen3
module load Python/3.14.4-foss-2026

# Install Galaxy on first launch if not already present
if [[ ! -f "${GALAXY_PATH}/run.sh" ]]; then
  echo "First launch: installing Galaxy to ${GALAXY_PATH} (this may take 10-20 minutes)..."
  mkdir -p "${HOME}/ondemand/data/Galaxy"
  git clone https://github.com/galaxyproject/galaxy.git "${GALAXY_PATH}"
  cd "${GALAXY_PATH}"
  git checkout v26.0.0

  # Add Slurm dynamic job rules
  (
  umask 077
  cat > "${GALAXY_PATH}/lib/galaxy/jobs/rules/destinations.py" << 'PYEOF'
import logging
from galaxy.jobs import JobDestination

log = logging.getLogger(__name__)


def dynamic_cores_time(app, tool, job, user_email, resource_params):
    if not resource_params.get("cores") and not resource_params.get("time"):
        default_destination_id = app.job_config.get_destination(None)
        log.warning('(%s) no cores or time params, using default: %s' % (job.id, default_destination_id.runner))
        return default_destination_id

    try:
        cores = resource_params.get("cores", "1")
        time  = resource_params.get("time", "1")
        native = '--ntasks=1 --cpus-per-task=%s --time=%s:00:00' % (cores, time)
    except Exception:
        default_destination_id = app.job_config.get_destination(None)
        log.warning('(%s) failed to build Slurm spec, using default: %s' % (job.id, default_destination_id.runner))
        return default_destination_id

    log.info('dynamic_cores_time: nativeSpecification=%s', native)
    return JobDestination(runner="slurm", params={"nativeSpecification": native})
PYEOF
  )

  # Set up Python virtualenv
  cd "${GALAXY_PATH}"
  . ./scripts/common_startup_functions.sh
  GALAXY_PID=galaxy.pid
  GALAXY_LOG=galaxy.log
  PID_FILE=$GALAXY_PID
  LOG_FILE=$GALAXY_LOG
  parse_common_args
  run_common_start_up
  setup_python

  echo "Galaxy installation complete."
else
  echo "Galaxy already installed at ${GALAXY_PATH}."
fi

cd "${PWD}"

# Generate Galaxy job configuration file (Galaxy 22+ YAML format)
(
umask 077
cat > "${JOB_CONFIG_FILE_PATH}" << EOL
runners:
  local:
    load: galaxy.jobs.runners.local:LocalJobRunner
  slurm:
    load: galaxy.jobs.runners.slurm:SlurmJobRunner
  dynamic:
    load: galaxy.jobs.runners.dynamic:DynamicJobRunner
    rules_module: galaxy.jobs.rules

execution:
  default: <%= context.job_runner %>
  environments:
    local:
      runner: local
      slots: <%= ppn %>
    slurm:
      runner: slurm
      native_specification: "--ntasks=1 --cpus-per-task=<%= ppn %> --time=05:00:00 --account=<%= context.account %>"
    dynamic_cores_time:
      runner: dynamic
      type: python
      function: dynamic_cores_time

resources:
  default: basic
  groups:
    basic:
      - cores
      - time
EOL
)

# Generate Galaxy job resource parameter configuration file
(
umask 077
cat > "${JOB_RESOURCE_PARAMS_CONF_FILE_PATH}" << EOL
<parameters>
  <param label="Cores" name="cores" type="integer" min="1" max="16" value="1" help="Number of processing cores (1-16). Leave blank to use default." />
  <param label="Walltime" name="time" type="integer" size="3" min="1" max="24" value="1" help="Maximum job time in hours (1-24). Leave blank to use default." />
</parameters>
EOL
)

# Generate Galaxy workflow resource parameter configuration file
(
umask 077
cat > "${WORKFLOW_RESOURCE_PARAMS_CONF_FILE_PATH}" << EOL
<parameters>
    <param label="Processors" name="processors" type="integer" min="1" max="16" value="" help="Number of processing cores (1-16). Leave blank to use default." />
    <param label="Memory" name="memory" type="integer" min="1" max="128" value="" help="Memory in GB (1-128). Leave blank to use default." />
    <param label="Time" name="time" type="integer" min="1" max="720" value="" help="Maximum job time in hours (1-720). Leave blank to use default." />
    <param label="Project" name="project" type="text" value="" help="NeSI project code. Leave blank to use default." />
    <param label="Workflow Job Priority" name="priority" type="select" value="med" help="Priority for jobs in this workflow.">
        <option value="low" label="Low"/>
        <option value="med" label="Medium"/>
        <option value="high" label="High"/>
    </param>
</parameters>
EOL
)

# Generate Galaxy configuration file
(
umask 077
cat > "${GALAXY_CONFIG_FILE}" << EOL
galaxy:
  data_dir: ${DATAROOT}
  single_user: ${EMAIL}
  tool_dependency_dir: ${GALAXY_PATH}/database/dependencies
  job_resource_params_file: ${JOB_RESOURCE_PARAMS_CONF_FILE_PATH}
  workflow_resource_params_file: ${WORKFLOW_RESOURCE_PARAMS_CONF_FILE_PATH}
  admin_users: ${EMAIL}
  job_config_file: ${JOB_CONFIG_FILE_PATH}
  galaxy_url_prefix: /rnode/${HOSTNAME}/${port}

gravity:
  gunicorn:
    bind: "0.0.0.0:${port}"
    workers: 1
    timeout: 300
  celery:
    enable: false
EOL
)
